# --- SAP S/4HANA Cloud (Public Edition) MCP server configuration ---
# Copy to .env — never commit .env.

# The API host of the tenant (note the "-api" suffix), e.g.
#   https://my123456-api.s4hana.cloud.sap
S4HC_BASE_URL=

# =============================================================================
# Option A: Basic auth with a communication user (simplest)
# =============================================================================
# Create in Fiori "Maintain Communication Users", then assign it to a
# Communication System, then create Communication Arrangements (confirm IDs in tenant):
#   REQUIRED  API_JOURNALENTRYITEMBASIC_SRV  → SAP_COM_0087 or SAP_COM_0241
#   optional  API_COSTCENTER_SRV             → names (SAP_COM_0087)
#   optional  API_FINPLANNINGENTRYITEM_SRV   → plan (SAP_COM_0087)
#   optional  API_GLACCOUNTLINEITEM          → postings (SAP_COM_0303)
S4HC_USER=
S4HC_PASSWORD=
# If the password contains '$', wrap the value in single quotes so the shell does not expand it.

# =============================================================================
# Option B: X.509 client certificate (communication user with certificate)
# =============================================================================
# S4HC_CLIENT_CERT=/path/to/cert.pem
# S4HC_CLIENT_KEY=/path/to/key.pem
# ...or inline PEM for hosted secrets:
# S4HC_CLIENT_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# S4HC_CLIENT_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# =============================================================================
# Option C: per-request headers (multi-tenant GenAI Studio)
# =============================================================================
# Leave the above empty and have the MCP client inject:
#   x-s4hc-base-url, x-s4hc-user, x-s4hc-password

# =============================================================================
# Defaults
# =============================================================================
# S4HC_LEDGER=0L
# S4HC_LANGUAGE=EN
# S4HC_CONTROLLING_AREA=A000   # optional: pre-filter every query to one controlling area
# S4HC_MASTER_CACHE_TTL=600
# S4HC_PAGE_SIZE=1000
# S4HC_MAX_ROWS=50000
# LOG_LEVEL=INFO

# =============================================================================
# Governance
# =============================================================================
# Backend data scope (comma lists). Per connection: x-s4hc-allowed-company-codes / x-s4hc-allowed-cost-centers
# S4HC_ALLOWED_COMPANY_CODES=1010
# S4HC_ALLOWED_COST_CENTERS=4100,4120
# S4HC_RATE_LIMIT_PER_MIN=120
# S4HC_MAX_PAGES=100
# Require a bearer key on /mcp (recommended for any shared deployment)
# S4HC_MCP_API_KEY=
# Admin-only raw OData tool (keep false in production)
# S4HC_ENABLE_RAW_ODATA=false

# =============================================================================
# Service paths — override with the inbound URL from the Communication Arrangement if different
# =============================================================================
# S4HC_JOURNAL_ITEM_SERVICE=/sap/opu/odata/sap/API_JOURNALENTRYITEMBASIC_SRV
# S4HC_COSTCENTER_SERVICE=/sap/opu/odata/sap/API_COSTCENTER_SRV
# S4HC_PLAN_SERVICE=/sap/opu/odata/sap/API_FINPLANNINGENTRYITEM_SRV
# S4HC_GLLINEITEM_SERVICE=/sap/opu/odata/sap/API_GLACCOUNTLINEITEM

# HTTP transport (only with --http)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_TRUST_PROXY=true
